// Promo MAPST: the security rules of the database (Phase 6).
// Written by Claude chat. The owner pastes this file in the Firebase console:
// Firestore Database > Règles > replace everything > Publier.
//
// In plain words:
//   - An account is a pseudo. Its hidden address is <pseudo>@promo-mapst.example.com,
//     so the rules know who is asking from the address inside the sign-in token.
//   - Creating a profile needs the class code: the code is the NAME of a document in
//     « codes », which nobody can read or list. The rules only check that it exists.
//   - Each person reads and writes only their own profile and progress.
//   - Members of the class read the classement and the questions.
//   - Only the admin (a document with their pseudo in « admins », created by hand)
//     answers questions and deletes any of them.
//   - Everything not written here is refused.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[a-z0-9_-]{3,15}@promo-mapst[.]example[.]com$');
    }
    function me() {
      return request.auth.token.email.split('@')[0];
    }
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/membres/$(me()));
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(me()));
    }

    // The class code(s). Created by hand in the console. Closed to everyone.
    match /codes/{code} {
      allow read, write: if false;
    }

    // Who is admin. Created by hand in the console. Each person may check their own.
    match /admins/{id} {
      allow get: if signedIn() && id == me();
      allow list, write: if false;
    }

    // One profile per pseudo: the pseudo as typed, the class code used, the progress
    // (one JSON text, 200 000 characters at most) and two dates.
    match /membres/{id} {
      allow get: if signedIn() && id == me();
      allow list: if false;

      allow create: if signedIn() && id == me()
        && request.resource.data.keys().hasAll(['pseudo', 'code', 'creeLe', 'progres', 'majLe'])
        && request.resource.data.keys().hasOnly(['pseudo', 'code', 'creeLe', 'progres', 'majLe'])
        && request.resource.data.pseudo is string
        && request.resource.data.pseudo.lower() == id
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[A-Za-z0-9-]{4,20}$')
        && exists(/databases/$(database)/documents/codes/$(request.resource.data.code))
        && request.resource.data.progres is string
        && request.resource.data.progres.size() <= 200000
        && request.resource.data.creeLe == request.time
        && request.resource.data.majLe == request.time;

      allow update: if signedIn() && id == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progres', 'majLe'])
        && request.resource.data.progres is string
        && request.resource.data.progres.size() <= 200000
        && request.resource.data.majLe == request.time;

      allow delete: if signedIn() && id == me();
    }

    // The classement: one line per person who chose to appear. XP of the week.
    // 400 XP at most per write (three lessons and a bit), one write every 10 seconds,
    // and the XP of a week never goes down.
    function scoreOk(d) {
      return d.keys().hasAll(['pseudo', 'xp', 'semaine', 'majLe'])
        && d.keys().hasOnly(['pseudo', 'xp', 'semaine', 'majLe'])
        && d.pseudo is string && d.pseudo.lower() == me()
        && d.xp is int && d.xp >= 0 && d.xp <= 20000
        && d.semaine is string && d.semaine.matches('^20[0-9]{2}-W[0-9]{2}$')
        && d.majLe == request.time;
    }
    match /classement/{id} {
      allow read: if isMember();
      allow create: if isMember() && id == me()
        && scoreOk(request.resource.data)
        && request.resource.data.xp <= 3000;
      allow update: if isMember() && id == me()
        && scoreOk(request.resource.data)
        && request.time > resource.data.majLe + duration.value(10, 's')
        && (
          (request.resource.data.semaine == resource.data.semaine
            && request.resource.data.xp >= resource.data.xp
            && request.resource.data.xp - resource.data.xp <= 400)
          ||
          (request.resource.data.semaine > resource.data.semaine
            && request.resource.data.xp <= 400)
        );
      allow delete: if signedIn() && id == me();
    }

    // The questions of the class.
    //   texte      the question, 500 characters at most
    //   auteur     the pseudo in lowercase (who asked), pseudo: as typed
    //   chapitre   a chapter id, or ""
    //   reponse    "" until the admin answers; reponduLe: the date of the answer
    //   aussi      the pseudos who tapped « Moi aussi »
    match /questions/{qid} {
      allow read: if isMember();

      allow create: if isMember()
        && request.resource.data.keys().hasAll(['texte', 'auteur', 'pseudo', 'chapitre', 'creeLe', 'reponse', 'aussi'])
        && request.resource.data.keys().hasOnly(['texte', 'auteur', 'pseudo', 'chapitre', 'creeLe', 'reponse', 'aussi'])
        && request.resource.data.texte is string
        && request.resource.data.texte.size() >= 3
        && request.resource.data.texte.size() <= 500
        && request.resource.data.auteur == me()
        && request.resource.data.pseudo is string
        && request.resource.data.pseudo.lower() == me()
        && request.resource.data.chapitre is string
        && request.resource.data.chapitre.size() <= 40
        && request.resource.data.reponse == ''
        && request.resource.data.aussi is list
        && request.resource.data.aussi.size() == 0
        && request.resource.data.creeLe == request.time;

      allow update: if
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reponse', 'reponduLe'])
          && request.resource.data.reponse is string
          && request.resource.data.reponse.size() <= 2000)
        ||
        (isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aussi'])
          && request.resource.data.aussi is list
          && request.resource.data.aussi.size() <= 60
          && request.resource.data.aussi.toSet().difference(resource.data.aussi.toSet()).hasOnly([me()])
          && resource.data.aussi.toSet().difference(request.resource.data.aussi.toSet()).hasOnly([me()]));

      allow delete: if isAdmin() || (isMember() && resource.data.auteur == me());
    }
  }
}
